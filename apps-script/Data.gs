uyó 450 g","Se duplicó"],"answer":"No cambió","explanation":"El cambio se obtiene comparando 450 g con 450 g.","time":40,"skill":"resolver con datos","readingRef":"k4"},{"id":"measurement-v253-u02-q35","type":"choice","prompt":"Un objeto marcó 2000 g al inicio y 1750 g al final. ¿Qué cambio muestran las mediciones?","options":["Disminuyó 250 g","Aumentó 250 g","Disminuyó 3750 g","No cambió"],"answer":"Disminuyó 250 g","explanation":"El cambio se obtiene comparando 2000 g con 1750 g.","time":40,"skill":"resolver con datos","readingRef":"k4"},{"id":"measurement-v253-u02-q36","type":"choice","prompt":"Un objeto marcó 750 g al inicio y 900 g al final. ¿Qué cambio muestran las mediciones?","options":["Aumentó 150 g","Disminuyó 150 g","Aumentó 1650 g","No cambió"],"answer":"Aumentó 150 g","explanation":"El cambio se obtiene comparando 750 g con 900 g.","time":40,"skill":"resolver con datos","readingRef":"k4"},{"id":"measurement-v253-u02-q37","type":"choice","prompt":"Un objeto marcó 980 g al inicio y 1020 g al final. ¿Qué cambio muestran las mediciones?","options":["Aumentó 40 g","Disminuyó 40 g","Aumentó 2000 g","No cambió"],"answer":"Aumentó 40 g","explanation":"El cambio se obtiene comparando 980 g con 1020 g.","time":40,"skill":"resolver con datos","readingRef":"k4"},{"id":"measurement-v253-u02-q38","type":"choice","prompt":"Un objeto marcó 1600 g al inicio y 1400 g al final. ¿Qué cambio muestran las mediciones?","options":["Disminuyó 200 g","Aumentó 200 g","Disminuyó 3000 g","No cambió"],"answer":"Disminuyó 200 g","explanation":"El cambio se obtiene comparando 1600 g con 1400 g.","time":40,"skill":"resolver con datos","readingRef":"k4"},{"id":"measurement-v253-u02-q39","type":"choice","prompt":"Un objeto marcó 325 g al inicio y 400 g al final. ¿Qué cambio muestran las mediciones?","options":["Aumentó 75 g","Disminuyó 75 g","Aumentó 725 g","No cambió"],"answer":"Aumentó 75 g","explanation":"El cambio se obtiene comparando 325 g con 400 g.","time":40,"skill":"resolver con datos","readingRef":"k4"},{"id":"measurement-v253-u02-q40","type":"choice","prompt":"Un objeto marcó 1100 g al inicio y 950 g al final. ¿Qué cambio muestran las mediciones?","options":["Disminuyó 150 g","Aumentó 150 g","Disminuyó 2050 g","No cambió"],"answer":"Disminuyó 150 g","explanation":"El cambio se obtiene comparando 1100 g con 950 g.","time":40,"skill":"resolver con datos","readingRef":"k4"}],"reading":{"title":"Caso: dos mochilas en la balanza","lead":"La vista puede engañar; la balanza da un número que sí se puede comprobar.","context":"Coloca un objeto en una balanza ajustada a cero y lee el valor. Para comparar dos objetos, usa el mismo procedimiento. Si los datos están en unidades distintas, conviértelos antes. Una diferencia se obtiene restando el valor menor al mayor.","keyIdeas":[{"id":"k1","title":"Copia exactamente la lectura","text":"No cambies el número ni la unidad que muestra la balanza.","example":"Si marca 750 g, registra 750 g."},{"id":"k2","title":"Compara los valores","text":"Con la misma unidad, el número mayor indica el registro mayor.","example":"820 g es mayor que 640 g."},{"id":"k3","title":"Convierte cuando haga falta","text":"1000 g equivalen a 1 kg.","example":"2500 g = 2,5 kg."},{"id":"k4","title":"Calcula el cambio","text":"Compara el valor inicial y el final para saber cuánto aumentó o disminuyó.","example":"500 g → 620 g: aumentó 120 g."}],"strategy":"Mira primero la unidad. Si ambos datos usan la misma, compara o resta directamente.","remember":"No decidas por el tamaño del objeto; usa la lectura de la balanza.","keywords":["balanza","g","kg","lectura","comparar","convertir","aumentar","disminuir"]},"phase":"PASO 1 · MEDIR"},{"id":3,"title":"Medir cuánto dura una actividad","intro":"Define un inicio y un final, usa un cronómetro y compara duraciones en segundos o minutos.","lesson":["Define un inicio y un final, usa un cronómetro y compara duraciones en segundos o minutos.","Resuelve cada situación usando los números y el p