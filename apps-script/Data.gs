illos y revisa siempre las unidades."],"questions":[{"id":"ohm-u06-0","type":"short","prompt":"Calcula y escribe el resultado: Con I=0.05 A y R=10 Ω, calcula V.","answer":"0.5 V","accepted":["0.5 V"],"explanation":"V = I × R = 0.05 × 10 = 0.5 V.","time":55,"skill":"respuesta corta","readingRef":"k1"},{"id":"ohm-u06-1","type":"truefalse","prompt":"Verdadero o falso: al resolver «Con I=0.1 A y R=40 Ω, calcula V», se obtiene «5 V».","answer":"Falso","explanation":"No. La respuesta correcta es «4 V», no «5 V».","time":30,"skill":"verdadero o falso","readingRef":"k1"},{"id":"ohm-u06-2","type":"choice","prompt":"Con I=0.2 A y R=80 Ω, calcula V.","options":["16 V","17 V","15 V","80 V"],"answer":"16 V","explanation":"V = I × R = 0.2 × 80 = 16 V.","time":35,"skill":"cálculo","readingRef":"k1"},{"id":"ohm-u06-3","type":"choice","prompt":"Con I=0.25 A y R=20 Ω, calcula V.","options":["5 V","6 V","4 V","20 V"],"answer":"5 V","explanation":"V = I × R = 0.25 × 20 = 5 V.","time":35,"skill":"cálculo","readingRef":"k1"},{"id":"ohm-u06-4","type":"choice","prompt":"Con I=0.5 A y R=50 Ω, calcula V.","options":["25 V","26 V","24 V","50 V"],"answer":"25 V","explanation":"V = I × R = 0.5 × 50 = 25 V.","time":35,"skill":"cálculo","readingRef":"k1"},{"id":"ohm-u06-5","type":"short","prompt":"Calcula y escribe el resultado: Con I=0.05 A y R=100 Ω, calcula V.","answer":"5 V","accepted":["5 V"],"explanation":"V = I × R = 0.05 × 100 = 5 V.","time":55,"skill":"respuesta corta","readingRef":"k1"},{"id":"ohm-u06-6","type":"truefalse","prompt":"Verdadero o falso: al resolver «Con I=0.1 A y R=30 Ω, calcula V», se obtiene «3 V».","answer":"Verdadero","explanation":"Sí. La respuesta es «3 V».","time":30,"skill":"verdadero o falso","readingRef":"k1"},{"id":"ohm-u06-7","type":"choice","prompt":"Con I=0.2 A y R=60 Ω, calcula V.","options":["12 V","13 V","11 V","60 V"],"answer":"12 V","explanation":"V = I × R = 0.2 × 60 = 12 V.","time":35,"skill":"cálculo","readingRef":"k1"},{"id":"ohm-u06-8","type":"choi