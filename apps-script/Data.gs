const BANKS={"arduino":{"version":3,"moduleKey":"arduino","title":"ArduinoQuest","short":"Arduino","icon":"🤖","color":"#75e4a3","instructions":"Cada submódulo comienza con 10 retos variados elegidos de un banco de 40. Hay selección, verdadero/falso, respuesta corta, ahorcado, memoria, relacionar y, cuando aplica, ordenar. Cada error añade dos refuerzos de esa misma pregunta más adelante.","units":[{"id":1,"title":"La placa Arduino","intro":"Arduino es una placa programable con entradas, salidas y un microcontrolador.","lesson":["Arduino es una placa programable con entradas, salidas y un microcontrolador.","Relaciona cada palabra con una situación real antes de responder.","Si fallas, la misma idea volverá más adelante para comprobar que ya quedó clara."],"questions":[{"id":"arduino-u01-c1-q1","type":"choice","prompt":"¿Cuál definición explica correctamente el concepto «microcontrolador»?","options":["Circuito que ejecuta el programa","Conexión usada para programar y alimentar en muchos casos","Punto de conexión para señales","Referencia de tierra del circuito"],"answer":"Circuito que ejecuta el programa","explanation":"«microcontrolador» se entiende como circuito que ejecuta el programa.","time":35,"skill":"comprender","readingRef":"k1"},{"id":"arduino-u01-c1-q2","type":"choice","prompt":"¿Cuál situación es un ejemplo claro de «microcontrolador»?","options":["Cable al computador","Pin digital 8","Conectar retorno a GND","Chip principal de la placa"],"answer":"Chip principal de la placa","explanation":"El caso «Chip principal de la placa» aplica directamente la idea de «microcontrolador».","time":35,"skill":"reconocer ejemplos","readingRef":"k1"},{"id":"arduino-u01-c1-q3","type":"truefalse","prompt":"Verdadero o falso: la definición de «microcontrolador» es: «Circuito que ejecuta el programa».","answer":"Verdadero","explanation":"Verdadero. Esa es la definición trabajada para «microcontrolador».","time":30,"skill":"verdadero o falso","readingRef":"k1"},{"id":"arduin